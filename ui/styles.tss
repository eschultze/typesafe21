GameScreen {
    layout: horizontal;
}

#left-column {
    width: 60%;
    height: 100%;
    layout: vertical;
}

#right-column {
    width: 40%;
    height: 100%;
    layout: vertical;
}

#dealer-panel {
    height: 2fr;
    border: solid $primary;
    padding: 0 1;
}

#players-panel {
    height: 4fr;
    border: solid $primary;
    padding: 0 1;
}

#deck-panel {
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

#scoreboard-panel {
    height: 2fr;
    border: solid $primary;
    padding: 0 1;
}

#balance-chart {
    height: 3fr;
    border: solid $primary;
    padding: 0 1;
}

#controls-row {
    height: auto;
    min-height: 1;
    padding: 0 1;
}

#controls-content {
    width: 50%;
}

#rounds-input {
    width: 50%;
}

#controls-panel {
    height: 1fr;
    border: solid $primary;
    padding: 0 1;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $surface;
}

#menu-title {
    text-align: center;
    width: 100%;
    padding: 1 0;
    text-style: bold;
    color: $accent;
}

#menu-container {
    align: center middle;
    width: 100%;
    height: 100%;
}

#menu-options {
    width: 40;
    max-height: 12;
}

#summary-container {
    align: center middle;
    width: 100%;
    height: 100%;
    padding: 2 4;
}

#summary-content {
    width: 100%;
    height: auto;
}

#history-container {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#history-title {
    width: 100%;
    text-align: center;
    text-style: bold;
}
